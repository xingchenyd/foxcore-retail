<view class="page"><view class="eyebrow">SALES / EVERY TRANSACTION COUNTS</view><view class="row"><view class="title">销售工作台</view><button class="primary compact" bindtap="create">＋ 开单</button></view><view class="subtitle">核对状态，再进行下一步。</view>
  <input class="search" value="{{query}}" bindinput="search" placeholder="搜索已加载记录：单号 / 展位"/><view class="filters"><view wx:for="{{filters}}" wx:key="id" class="chip {{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></view>
  <view class="row small muted"><text>已加载 {{items.length}} / {{total}} 条 · 筛选仅限已加载记录</text><text class="link" bindtap="clear">清除</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">刷新</button></view>
  <view wx:for="{{visible}}" wx:key="id" class="card record gap" data-id="{{item.id}}" bindtap="detail" hover-class="pressed"><view class="row"><text class="record-title">{{item.sale_no || '草稿单 #' + item.id}}</text><text class="badge {{item.state}}">{{item.label}}</text></view><view class="record-sub">展位 {{item.booth_location}} · 班次 #{{item.shift_id}}</view><view class="row"><text class="money"><text class="currency">CAD</text>{{item.state === 'DRAFT' ? '待核价' : item.money}}</text><text class="link">查看详情 →</text></view></view>
  <view wx:if="{{loading}}" class="loading">正在加载销售记录…</view><view wx:if="{{!loading && !error && !visible.length}}" class="empty">{{items.length ? '当前筛选没有匹配记录' : '还没有销售记录，从第一笔开始。'}}</view><button wx:if="{{hasMore}}" class="ghost gap" bindtap="more" disabled="{{loading}}">加载更多记录</button>
</view>
