<view class="page"><view class="eyebrow">COMMISSION / SEE WHAT YOU EARN</view><view class="title">佣金与结算</view><view class="subtitle">{{owner ? '汇总销售正项与退货冲回，核对每次付款。' : '查看本人佣金来源、退货冲回与结算进度。'}}</view>
  <view wx:if="{{owner}}" class="card gap"><view class="strong">准备员工结算</view><picker class="gap" range="{{people}}" range-key="label" value="{{personIndex}}" bindchange="person" disabled="{{busy}}"><view class="picker">{{personIndex >= 0 ? people[personIndex].label : '选择员工'}} ▾</view></picker><label class="label">结算币种</label><picker range="{{currencyOptions}}" value="{{currencyIndex}}" bindchange="currency"><view class="picker">{{currencyOptions[currencyIndex]}} ▾</view></picker><button class="primary gap" bindtap="prepare" disabled="{{busy || loading}}" loading="{{busy}}">核算未结佣金</button><view class="hint">汇总全部未认领流水，包含退货负项；金额以服务端结果为准。</view></view>
  <view class="filters"><view class="chip {{tab === 'entries' ? 'selected' : ''}}" data-tab="entries" bindtap="tab">佣金流水</view><view class="chip {{tab === 'settlements' ? 'selected' : ''}}" data-tab="settlements" bindtap="tab">结算记录</view></view><view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">重新加载</button></view>
  <block wx:if="{{tab === 'entries'}}"><view class="muted small">已加载 {{entries.length}} / {{entryTotal}} 条 · 正数计入，负数冲回</view><view wx:for="{{entries}}" wx:key="id" class="card gap"><view class="row"><view class="grow"><view class="record-title">{{item.source_kind === 'SALE' ? '销售佣金' : '退货冲回'}}</view><view class="record-sub">{{item.source_kind === 'SALE' ? '销售' : '退货'}} #{{item.source_id}} · 员工 #{{item.salesperson_id}}</view></view><text class="strong">{{item.currency}} {{item.money}}</text></view></view><view wx:if="{{!loading && !entries.length && !error}}" class="empty">暂无佣金流水，销售过账后会自动产生。</view><button wx:if="{{entryMore}}" class="ghost gap" bindtap="more" disabled="{{loading}}">加载更多流水</button></block>
  <block wx:else><view class="muted small">已加载 {{settlements.length}} / {{settlementTotal}} 条</view><view wx:for="{{settlements}}" wx:key="id" class="card gap" data-id="{{item.id}}" bindtap="detail" hover-class="pressed"><view class="row"><text class="record-title">结算 #{{item.id}}</text><text class="badge {{item.state}}">{{item.label}}</text></view><view class="record-sub">员工 #{{item.salesperson_id}}</view><view class="row"><text class="money"><text class="currency">{{item.currency}}</text>{{item.money}}</text><text class="link">查看明细 →</text></view></view><view wx:if="{{!loading && !settlements.length && !error}}" class="empty">暂无结算记录。</view><button wx:if="{{settlementMore}}" class="ghost gap" bindtap="more" disabled="{{loading}}">加载更多结算</button></block><view wx:if="{{loading}}" class="loading">正在同步佣金…</view>
</view>
