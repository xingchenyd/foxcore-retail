<view class="page"><view class="eyebrow">RETURN DETAIL / RECONCILE WITH CARE</view><view class="row"><view class="title">退货 #{{id}}</view><text wx:if="{{row}}" class="badge {{row.state}}">{{label}}</text></view><view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">刷新单据</button></view><view wx:if="{{loading}}" class="loading">正在同步退货状态…</view>
  <block wx:if="{{row}}"><view class="hero"><view class="muted">{{row.state === 'DRAFT' ? '退款金额待核价' : '本次退款金额 · 含税'}}</view><view class="money"><text class="currency">{{row.currency}}</text>{{row.state === 'DRAFT' ? '—' : total}}</view><view class="muted small gap">原销售 #{{row.sale_id}} · {{row.reason}}</view></view><view wx:for="{{lines}}" wx:key="line_no" class="card"><view class="row"><view class="grow"><view class="strong">原单第 {{item.sale_line_no}} 行 · {{item.quantity}} 件</view><view class="muted small">{{item.disposition === 'RESTOCK' ? '回可售库存' : '损坏，不回可售库存'}}</view></view><text>{{row.currency}} {{item.money}}</text></view></view>
    <button wx:if="{{row.state === 'DRAFT'}}" class="primary gap" bindtap="authorize" disabled="{{busy || loading}}" loading="{{busy}}">核价并授权退款</button>
    <view wx:if="{{row.state === 'AUTHORIZED'}}" class="card"><view class="notice">先在线下完成退款，再登记。结果不明时先核对，不要重复退款。</view><radio-group bindchange="method"><label class="check"><radio value="CASH" checked="{{refundMethod === 'CASH'}}"/>现金退款</label><label class="check"><radio value="TERMINAL" checked="{{refundMethod === 'TERMINAL'}}"/>原支付终端退款</label></radio-group><block wx:if="{{refundMethod === 'CASH'}}"><label class="label">退款现金所属班次</label><picker range="{{shifts}}" range-key="booth_location" value="{{shiftIndex}}" bindchange="shift"><view class="picker">{{shiftIndex >= 0 ? shifts[shiftIndex].booth_location : '选择本人进行中班次'}} ▾</view></picker></block><label class="label">退款参考号</label><input value="{{refundReference}}" data-field="refundReference" bindinput="input" maxlength="120" disabled="{{busy}}"/><checkbox-group bindchange="check"><label class="check"><checkbox value="refunded" checked="{{refunded}}" color="#214E42"/>线下退款已完成，金额及商品去向已核对</label></checkbox-group><button class="primary gap" bindtap="post" disabled="{{busy || loading}}" loading="{{busy}}">确认退款登记</button></view>
    <view wx:if="{{row.state === 'DRAFT' || row.state === 'AUTHORIZED'}}" class="card gap"><view class="strong">取消本次退货</view><label class="label">取消原因</label><textarea value="{{reason}}" data-field="reason" bindinput="input" disabled="{{busy}}" maxlength="500"/><checkbox-group wx:if="{{row.state === 'AUTHORIZED'}}" bindchange="check"><label class="check"><checkbox value="reconciled" checked="{{reconciled}}" color="#214E42"/>线下退款未执行，或已核对并撤销</label></checkbox-group><button class="danger gap" bindtap="cancel" disabled="{{busy || loading}}">取消退货</button></view>
    <view wx:if="{{row.state === 'POSTED'}}" class="notice">退款已登记。可售退货已回库，相应佣金已冲回；原销售历史保留。</view>
  </block>
</view>
