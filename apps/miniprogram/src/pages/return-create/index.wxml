<view class="page"><view class="eyebrow">RETURN / LINK TO THE ORIGINAL SALE</view><view class="title">创建退货草稿</view><view class="steps"><view class="step active">01 关联原单</view><view class="step">02 核价授权</view><view class="step">03 退款登记</view></view><view wx:if="{{loading}}" class="loading">正在读取原销售…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card"><label class="label">原销售</label><picker range="{{sales}}" range-key="label" value="{{saleIndex}}" bindchange="selectSale" disabled="{{busy || loading}}"><view class="picker">{{saleIndex >= 0 ? sales[saleIndex].label : '请选择已成交销售'}} ▾</view></picker><label class="label">原销售 ID（可查历史单）</label><input value="{{saleId}}" bindinput="saleInput" type="number" disabled="{{busy}}"/><button class="ghost compact gap" bindtap="lookup" disabled="{{busy || loading || !saleId}}">读取原单</button><label class="label">退货归属库位</label><picker range="{{locations}}" range-key="name" value="{{locationIndex}}" bindchange="location" disabled="{{busy}}"><view class="picker">{{locationIndex >= 0 ? locations[locationIndex].name : '请选择有效库位'}} ▾</view></picker><view class="hint">7 天内无损商品可退回此库位。损坏品不能退款，请进入损坏品管理。</view><label class="label">退货原因</label><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{busy}}"/></view>
  <view wx:for="{{lines}}" wx:key="saleLineNo" class="card"><checkbox-group data-index="{{index}}" data-field="selected" bindchange="toggle"><label class="check"><checkbox value="yes" checked="{{item.selected}}" color="#214E42"/><view class="grow"><view class="strong">{{item.name}}</view><view class="muted small">剩余可退 {{item.sold}} 件 · 单价 {{currency}} {{item.unit}}</view></view></label></checkbox-group><block wx:if="{{item.selected}}"><label class="label">本次退货数量</label><input type="number" value="{{item.quantity}}" data-index="{{index}}" bindinput="input" disabled="{{busy}}" maxlength="7"/></block></view>
  <view class="hint">剩余可退数量、退款税额及佣金冲回，以授权时服务端核对为准。历史退货不会被重复退款。</view><button class="primary gap" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !lines.length}}">保存草稿，进入退款核对</button>
</view>
