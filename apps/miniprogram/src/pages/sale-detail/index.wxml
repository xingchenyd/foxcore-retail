<view class="page"><view class="eyebrow">SALE DETAIL / TRACE EVERY STEP</view><view class="row"><view class="title">销售 #{{id}}</view><text wx:if="{{sale}}" class="badge {{sale.state}}">{{label}}</text></view>
  <view wx:if="{{loading}}" class="loading">正在核对最新状态…</view><view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">刷新单据状态</button></view><view wx:if="{{result}}" class="notice">{{result}}</view>
  <block wx:if="{{sale}}"><view class="steps"><view class="step active">01 录入商品</view><view class="step {{sale.state !== 'DRAFT' ? 'active' : ''}}">02 核价占库</view><view class="step {{sale.state === 'POSTED' ? 'active' : ''}}">03 确认成交</view></view>
    <view class="hero"><view class="muted">{{sale.state === 'DRAFT' ? '草稿 · 金额待核价' : '应收金额 · 含税'}}</view><view class="money"><text class="currency">CAD</text>{{sale.state === 'DRAFT' ? '—' : total}}</view><view class="muted small gap">{{sale.sale_no || '未成交草稿'}} · 班次 #{{sale.shift_id}}</view><view wx:if="{{sale.state !== 'DRAFT'}}" class="row small gap"><text>未税 {{net}}</text><text>税额 {{tax}}</text></view></view>
    <view wx:for="{{lines}}" wx:key="line_no" class="card"><view class="row"><view class="grow"><view class="line-name">{{item.name}}</view><view class="muted small">数量 {{item.quantity}} × CAD {{item.unit}}</view></view><text class="strong">{{item.net}}</text></view></view>
    <view wx:if="{{sale.state === 'DRAFT'}}" class="card"><view class="strong">下一步：核价并占用库存</view><view class="hint">此时仍可编辑商品。准备后将锁定成交快照。</view><view class="actions"><button class="ghost" bindtap="edit" disabled="{{busy}}">编辑草稿</button><button class="primary" bindtap="prepare" loading="{{busy}}" disabled="{{busy || loading}}">准备收款</button></view></view>
    <view wx:if="{{sale.state === 'CHECKOUT'}}" class="card"><view class="strong">登记实际收款</view><view class="notice">已占用库存。付款结果不明时请先核对，不要自动取消或重新开单。</view><radio-group bindchange="method"><label class="check"><radio value="CASH" checked="{{paymentMethod === 'CASH'}}" color="#214E42"/>现金</label><label class="check"><radio value="TERMINAL" checked="{{paymentMethod === 'TERMINAL'}}" color="#214E42"/>独立支付终端</label></radio-group>
      <block wx:if="{{paymentMethod === 'CASH'}}"><label class="label">现金实收 CAD</label><input type="digit" value="{{cashReceived}}" data-field="cashReceived" bindinput="input" disabled="{{busy}}" maxlength="14"/><view class="row gap"><text class="muted">应找零</text><text class="strong">CAD {{change}}</text></view></block><block wx:else><label class="label">终端交易参考号</label><input value="{{paymentReference}}" data-field="paymentReference" bindinput="input" disabled="{{busy}}" maxlength="120"/></block>
      <checkbox-group bindchange="checks"><label class="check"><checkbox value="paid" checked="{{paidConfirmed}}" color="#214E42"/>线下收款已完成，商品交付情况已核对</label></checkbox-group><button class="primary gap" bindtap="post" loading="{{busy}}" disabled="{{busy || loading}}">确认成交并过账</button></view>
    <view wx:if="{{sale.state === 'DRAFT' || (sale.state === 'CHECKOUT' && owner)}}" class="card"><view class="strong">取消与事实核对</view><label class="label">取消原因</label><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{busy}}"/><checkbox-group wx:if="{{sale.state === 'CHECKOUT'}}" bindchange="checks"><label class="check"><checkbox value="payment" checked="{{paymentReconciled}}" color="#214E42"/>收款未发生，或资金已核对并撤销</label><label class="check"><checkbox value="goods" checked="{{goodsRecovered}}" color="#214E42"/>商品未交付，或已收回</label></checkbox-group><button class="danger gap" bindtap="cancel" disabled="{{busy || loading}}">取消此销售</button></view>
    <view wx:if="{{sale.state === 'CHECKOUT' && !owner}}" class="notice">需要取消待收款销售时，请联系管理员核对资金和商品。</view><button wx:if="{{sale.state === 'POSTED' && owner}}" class="ghost gap" bindtap="returns">从此原单办理退货</button>
  </block>
</view>
