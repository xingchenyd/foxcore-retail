<view class="page"><view class="eyebrow">RETAIL OPERATIONS / SHARED FACTS</view><view class="title">业务办理中心</view><view class="subtitle">销售、库存与交班使用同一份业务记录。</view>
<picker range="{{modules}}" range-key="title" value="{{moduleIndex}}" bindchange="moduleChange" disabled="{{busy}}"><view class="picker strong">{{module.title}} ▾</view></picker><view class="hint gap">{{module.intro}}</view>
<view wx:if="{{loading}}" class="loading">正在同步业务记录…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{result}}" class="notice">{{result}}</view>
<view wx:if="{{action}}" class="card"><view class="line-name">{{action.title}} {{selected ? '#' + selected.id : ''}}</view>
<block wx:for="{{fields}}" wx:key="key" wx:for-item="field"><label class="label">{{field.label}}</label>
<picker wx:if="{{field.kind === 'select'}}" range="{{field.options}}" range-key="label" value="{{field.index}}" data-key="{{field.key}}" bindchange="select" disabled="{{busy}}"><view class="picker">{{field.options[field.index].label}} ▾</view></picker>
<checkbox-group wx:elif="{{field.kind === 'check'}}" data-key="{{field.key}}" bindchange="check"><label class="check"><checkbox value="yes" checked="{{field.value === 'yes'}}" color="#214E42"/>我已确认上述事实</label></checkbox-group>
<input wx:else type="{{field.inputType}}" value="{{field.value}}" data-key="{{field.key}}" bindinput="input" maxlength="{{field.key === 'reason' ? 500 : 200}}" disabled="{{busy}}"/>
</block><view wx:if="{{cashExpected}}" class="notice gap">服务器当前应交：{{cashExpected}}。提交时重新核对。</view>
<block wx:if="{{module.key === 'exchanges' && action.key === 'prepare'}}"><button class="ghost gap" bindtap="original" disabled="{{busy || !form.originalSaleId}}">读取原成交单</button><view wx:if="{{original}}" class="strong gap">退入原商品 · {{original.sale.currency}}</view>
<view wx:for="{{returned}}" wx:key="line_no" class="operation-line"><checkbox-group data-index="{{index}}" bindchange="returnCheck"><label class="check"><checkbox value="yes" checked="{{item.selected}}" disabled="{{item.remaining < 1}}" color="#214E42"/>{{item.name}} · 可退 {{item.remaining}} 件</label></checkbox-group><label class="label">退入数量</label><input type="number" value="{{item.count}}" data-index="{{index}}" bindinput="returnInput" disabled="{{busy}}"/></view>
<view class="strong gap">换出商品 · 含税成交价</view><view wx:for="{{outgoing}}" wx:key="key" class="operation-line"><picker range="{{products}}" range-key="name" value="{{item.productIndex}}" data-index="{{index}}" bindchange="product" disabled="{{busy}}"><view class="picker">{{item.productIndex >= 0 ? products[item.productIndex].name : '选择换出商品'}} ▾</view></picker><label class="label">数量</label><input type="number" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="lineInput" disabled="{{busy}}"/><label class="label">含税单价</label><input type="digit" value="{{item.finalUnitPrice}}" data-index="{{index}}" data-field="finalUnitPrice" bindinput="lineInput" disabled="{{busy}}"/><button class="ghost compact gap" data-index="{{index}}" bindtap="removeLine" disabled="{{busy || outgoing.length === 1}}">移除此行</button></view><button class="ghost gap" bindtap="addLine" disabled="{{busy || outgoing.length >= 100}}">＋ 添加换出商品</button></block>
<view wx:if="{{selected && selected.difference_cents !== undefined}}" class="hint gap">差额正数补收，负数退还；请按记录中的差额核对线下收付。</view><button class="primary gap" bindtap="submit" disabled="{{busy || loading}}" loading="{{busy}}">{{action.title}}</button><button wx:if="{{selected}}" class="ghost gap" bindtap="newForm" disabled="{{busy}}">返回新建</button></view>
<view class="section-head"><view class="strong">共享记录</view><text class="hint">总计 {{total}} 条</text></view><view wx:if="{{loaded && !items.length}}" class="empty">当前没有记录</view>
<view wx:for="{{items}}" wx:key="id" class="card" wx:for-item="row"><view class="row"><text class="line-name">#{{row.id}}</text><text class="badge">{{row.label}}</text></view><view wx:for="{{row.views}}" wx:key="label" wx:for-item="field" class="row small gap"><text class="muted">{{field.label}}</text><text class="operation-value">{{field.value}}</text></view><view wx:for="{{row.actions}}" wx:key="key" wx:for-item="act"><button class="ghost gap" data-id="{{row.id}}" data-action="{{act.key}}" bindtap="rowAction" disabled="{{busy}}">{{act.title}}</button></view></view>
<button wx:if="{{hasMore}}" class="ghost gap" bindtap="onReachBottom" disabled="{{loading}}">继续加载记录</button><view class="hint">当前页每 10 秒同步；也可下拉刷新。输入中的表单不会因列表同步而清空。</view></view>
