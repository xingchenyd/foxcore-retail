<view class="page">
  <view class="row"><view class="eyebrow">YOUR RETAIL, IN FOCUS</view><text class="badge">{{owner ? '管理员' : '销售顾问'}}</text></view>
  <view class="title">现场工作台</view><view class="subtitle">你好，{{username}}。从备货到收款，让每一步清楚可见。</view>
  <view class="hero"><view class="eyebrow">READY FOR YOUR NEXT SALE</view><view class="hero-title">把好生意，记清楚。</view><view class="muted small">选择班次与商品，核对金额，确认成交。</view><button class="primary gap" bindtap="newSale" hover-class="pressed">＋ 开始一笔销售</button></view>
  <view class="tiles"><view class="tile green"><view class="muted small">进行中的班次</view><view class="stat">{{active}}</view></view><view class="tile" bindtap="sales"><view class="muted small">待核对收款</view><view class="stat">{{pending}}</view></view></view>
  <view class="hint">以上仅统计最近各 20 条记录，完整记录请进入对应工作区。</view>
  <view class="section-title">现场任务</view>
  <view class="tiles"><view class="tile" bindtap="inventory" hover-class="pressed"><view class="tile-symbol">▦</view><view class="strong">库存与备货</view><view class="muted small">查看可售量与库存占用 →</view></view><view class="tile" bindtap="commissions" hover-class="pressed"><view class="tile-symbol">↗</view><view class="strong">佣金与结算</view><view class="muted small">每笔收入，都有来源 →</view></view><view wx:if="{{owner}}" class="tile" bindtap="returns" hover-class="pressed"><view class="tile-symbol">↶</view><view class="strong">退货与核对</view><view class="muted small">原单退货与退款登记 →</view></view><view class="tile" bindtap="sales" hover-class="pressed"><view class="tile-symbol">≡</view><view class="strong">销售记录</view><view class="muted small">草稿、收款与成交 →</view></view></view>
  <view class="section-title">近期班次</view><view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">重新加载</button></view><view wx:if="{{loading}}" class="loading">正在同步工作信息…</view>
  <view wx:for="{{shifts}}" wx:key="id" class="card"><view class="row"><text class="record-title">{{item.event_name}}</text><text class="badge {{item.status}}">{{item.label}}</text></view><view class="record-sub">{{item.booth_location}} · {{item.first_name}} {{item.last_name}}</view><view class="muted small">营业日 {{item.business_date}} · 班次 #{{item.id}}</view><view class="actions"><button wx:if="{{item.status === 'PLANNED'}}" class="primary compact" data-id="{{item.id}}" data-action="start" bindtap="shiftAction" disabled="{{busy}}">确认到岗并开班</button><button wx:if="{{item.status === 'ACTIVE'}}" class="ghost compact" data-id="{{item.id}}" data-action="close" bindtap="shiftAction" disabled="{{busy}}">结束班次</button></view></view>
  <view wx:if="{{!loading && !error && !shifts.length}}" class="empty">暂无班次，请联系管理员安排。</view><view class="footer">每一步，都有迹可循</view>
</view>
