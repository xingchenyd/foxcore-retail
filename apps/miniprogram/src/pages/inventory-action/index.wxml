<view class="page"><view class="eyebrow">INVENTORY / REGISTER THE FACTS</view><view class="title">{{title}}</view><view class="subtitle">每一次库存变化，都保留原因与经办记录。</view><view wx:if="{{loading}}" class="loading">正在加载商品与库位…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{result}}" class="notice">{{result}}</view>
  <view class="card"><label class="label">商品</label><picker range="{{products}}" range-key="name" value="{{productIndex}}" data-field="productIndex" bindchange="select" disabled="{{busy}}"><view class="picker">{{productIndex >= 0 ? products[productIndex].name : '请选择商品'}} ▾</view></picker>
    <block wx:if="{{type === 'transfer'}}"><label class="label">来源库位</label><picker range="{{locations}}" range-key="name" value="{{fromIndex}}" data-field="fromIndex" bindchange="select" disabled="{{busy}}"><view class="picker">{{fromIndex >= 0 ? locations[fromIndex].name : '请选择来源'}} ▾</view></picker></block>
    <block wx:if="{{type !== 'receive'}}"><label class="label">{{type === 'adjust' ? '盘点库位' : '目标库位'}}</label><picker range="{{locations}}" range-key="name" value="{{toIndex}}" data-field="toIndex" bindchange="select" disabled="{{busy || balanceLoading}}"><view class="picker">{{toIndex >= 0 ? locations[toIndex].name : '请选择库位'}} ▾</view></picker></block>
    <view wx:if="{{type === 'receive'}}" class="hint gap">收货登记入主仓 MAIN。</view><view wx:if="{{type === 'adjust'}}" class="notice">当前账面在手 {{onHand}} 件。{{balanceLoading ? '正在核对版本…' : '填写实际盘点数量，系统记录差额。'}}</view>
    <label class="label">{{type === 'adjust' ? '实际盘点数量' : '数量'}}</label><input type="number" value="{{quantity}}" data-field="quantity" bindinput="input" maxlength="7" disabled="{{busy}}"/><label class="label">原因 / 交接说明</label><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{busy}}"/>
    <checkbox-group wx:if="{{type === 'transfer'}}" bindchange="check"><label class="check"><checkbox value="yes" checked="{{handover}}" color="#214E42"/>实物已完成交接，来源和目标数量已核对</label></checkbox-group><button class="primary gap" bindtap="submit" disabled="{{busy || loading || balanceLoading}}" loading="{{busy}}">确认登记</button>
  </view><view class="hint">库存发生并发变化时，系统会拒绝旧版本盘点。请重新选择库位加载最新版本后核对。</view>
</view>
