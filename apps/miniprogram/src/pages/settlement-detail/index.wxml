<view class="page"><view class="eyebrow">SETTLEMENT / EVERY ENTRY EXPLAINED</view><view class="row"><view class="title">结算 #{{id}}</view><text wx:if="{{row}}" class="badge {{row.state}}">{{label}}</text></view><view wx:if="{{error}}" class="error">{{error}}<button class="ghost compact gap" bindtap="load">刷新结算</button></view><view wx:if="{{loading}}" class="loading">正在核对结算记录…</view><block wx:if="{{row}}"><view class="hero"><view class="muted">员工 #{{row.salesperson_id}} · 结算金额</view><view class="money"><text class="currency">{{row.currency}}</text>{{total}}</view><view wx:if="{{row.payment_reference}}" class="muted gap">付款参考号 {{row.payment_reference}}</view></view>
  <view class="section-title">构成明细 · {{lines.length}} 项</view><view wx:for="{{lines}}" wx:key="entry_id" class="card"><view class="row"><view class="grow"><view class="strong">{{item.source_kind === 'SALE' ? '销售佣金' : '退货冲回'}} #{{item.source_id}}</view><view class="muted small">原单行 {{item.source_line_no}} · 流水 #{{item.entry_id}}</view></view><text>{{row.currency}} {{item.money}}</text></view></view>
  <block wx:if="{{owner && row.state === 'PREPARED'}}"><view class="card"><view class="strong">登记实际付款</view><label class="label">付款参考号</label><input value="{{reference}}" data-field="reference" bindinput="input" disabled="{{busy}}" maxlength="120"/><checkbox-group bindchange="checks"><label class="check"><checkbox value="paid" checked="{{paid}}" color="#214E42"/>已向员工完成线下付款，金额已核对</label></checkbox-group><button class="primary gap" bindtap="pay" disabled="{{busy || loading}}" loading="{{busy}}">确认付款登记</button></view><view class="card"><view class="strong">取消未付款结算</view><label class="label">取消原因</label><textarea value="{{reason}}" data-field="reason" bindinput="input" disabled="{{busy}}" maxlength="500"/><checkbox-group bindchange="checks"><label class="check"><checkbox value="reconciled" checked="{{reconciled}}" color="#214E42"/>线下付款未执行，或已核对并撤销</label></checkbox-group><button class="danger gap" bindtap="cancel" disabled="{{busy || loading}}">取消结算</button></view></block>
  <view wx:if="{{!owner && row.state === 'PREPARED'}}" class="notice">等待管理员核对线下付款。你可以在这里查看结算构成与状态。</view></block>
</view>
