<view class="page"><view class="eyebrow">NEW SALE / MAKE IT COUNT</view><view class="title">{{saleId ? '编辑销售草稿' : '开始一笔销售'}}</view><view class="steps"><view class="step active">01 录入商品</view><view class="step">02 核价占库</view><view class="step">03 确认成交</view></view>
  <view wx:if="{{loading}}" class="loading">正在加载班次与商品…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{conflict}}" class="card"><view class="line-name">本机与服务器草稿冲突</view><button class="ghost gap" bindtap="viewLocal">查看保留的本机副本</button><button class="ghost gap" bindtap="useServer">以当前显示内容重新开始编辑</button><button class="primary gap" bindtap="resolveLocal">我已逐项核对，以当前版本继续编辑</button><view class="hint">未确认前不能提交；原成交快照不会改变。</view></view>
  <view class="card"><view class="strong">跨设备草稿</view><view class="hint">{{cloudMessage}}</view><view class="actions"><button class="ghost compact" bindtap="loadCloud" disabled="{{busy || loading}}">载入云端副本</button><button class="ghost compact" bindtap="saveCloud" disabled="{{busy || loading || conflict}}">保存到云端</button></view></view><view class="card"><label class="label">销售班次</label><picker disabled="{{busy || !!saleId}}" range="{{shifts}}" range-key="label" value="{{shiftIndex}}" bindchange="selectShift"><view class="picker">{{shiftIndex >= 0 ? shifts[shiftIndex].label : '请选择进行中的班次'}} ▾</view></picker><view wx:if="{{!loading && !shifts.length}}" class="notice">没有可用班次，请先在工作台开班，或联系管理员安排。</view>
    <label class="label">添加商品</label><input value="{{productQuery}}" bindinput="searchProducts" placeholder="按商品名称或 SKU 筛选" disabled="{{busy}}"/><picker class="gap" disabled="{{busy}}" range="{{visibleProducts}}" range-key="name" value="{{productIndex}}" bindchange="selectProduct"><view class="picker">{{productIndex >= 0 ? visibleProducts[productIndex].name : '选择商品'}} ▾</view></picker><view class="hint">匹配 {{visibleProducts.length}} 项</view><button class="ghost compact gap" bindtap="add" disabled="{{busy || loading}}">＋ 加入销售明细</button></view>
  <view wx:for="{{lines}}" wx:key="productId" class="card"><view class="row"><view class="grow"><view class="line-name">{{item.name}}</view><view class="muted small">{{item.sku}} · 最低价 {{currency}} {{item.minPrice}}</view></view><button class="ghost compact" data-index="{{index}}" bindtap="remove" disabled="{{busy}}">移除</button></view><view class="line-grid"><view class="grow"><label class="label">数量</label><input type="number" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="inputLine" disabled="{{busy}}" maxlength="7"/></view><view class="grow"><label class="label">成交单价 {{currency}}</label><input type="digit" value="{{item.finalUnitPrice}}" data-index="{{index}}" data-field="finalUnitPrice" bindinput="inputLine" disabled="{{busy}}" maxlength="14"/></view></view><view class="row gap small"><text class="muted">行金额 · {{priceBasis === 'INCLUSIVE' ? '含税' : '未税'}}</text><text class="strong">{{currency}} {{item.subtotal}}</text></view></view>
  <view class="card"><view class="row"><text>录入金额 · {{priceBasis === 'INCLUSIVE' ? '含税' : '未税'}}</text><text class="money"><text class="currency">{{currency}}</text>{{subtotal}}</text></view><view class="hint">税额、最终应收及库存以准备收款时的服务端核对结果为准。</view><view wx:if="{{saved}}" class="hint">✓ 已保存本机录入草稿，尚未占用库存。</view><button class="primary gap" bindtap="save" disabled="{{busy || loading || !lines.length || shiftIndex < 0}}" loading="{{busy}}">保存草稿，进入核对</button></view>
</view>
