page { background:#F7F8F2; color:#203D34; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; line-height:1.6; }
view,text,input,textarea,button,picker { box-sizing:border-box; }
.page { padding:28rpx 32rpx 56rpx; }
.eyebrow { font-size:19rpx; letter-spacing:4rpx; color:#7F9462; font-weight:700; text-transform:uppercase; }
.title { font-size:48rpx; font-weight:750; letter-spacing:-1rpx; line-height:1.3; margin:8rpx 0 14rpx; }
.subtitle,.muted { color:#7E8981; font-size:24rpx; }
.section-title { font-size:31rpx; font-weight:650; margin:32rpx 0 16rpx; }
.card { background:#FFF; border:1rpx solid #E2E7D9; border-radius:28rpx; padding:28rpx; margin-bottom:20rpx; }
.hero { background:#214E42; color:#FFF; border-radius:30rpx; padding:34rpx; margin:26rpx 0; }
.hero .eyebrow,.hero .muted { color:#D0DFB4; }
.hero-title { font-size:39rpx; font-weight:650; margin:16rpx 0; }
.row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.row.start { align-items:flex-start; }
.grow { flex:1; min-width:0; }
.wrap { flex-wrap:wrap; }
.gap { margin-top:22rpx; }
.small { font-size:22rpx; }
.strong { font-weight:650; }
.money { font-size:42rpx; font-weight:700; letter-spacing:-1rpx; }
.currency { font-size:22rpx; font-weight:400; margin-right:8rpx; }
.badge { display:inline-block; background:#EEF3E5; color:#516B38; border-radius:10rpx; padding:4rpx 14rpx; font-size:22rpx; white-space:nowrap; }
.badge.CHECKOUT,.badge.AUTHORIZED,.badge.PREPARED { background:#FFF2D9; color:#936D28; }
.badge.CANCELLED,.badge.CLOSED { background:#F0F1ED; color:#79837B; }
.actions { display:flex; gap:16rpx; margin-top:22rpx; }
.actions button { flex:1; }
button { font-size:28rpx; border-radius:18rpx; line-height:1.4; padding:23rpx 24rpx; font-weight:600; margin:0; background:#EEF3E5; color:#214E42; transition:transform .12s,opacity .12s; }
button::after { border:0; }
button[disabled] { opacity:.5; }
.pressed { opacity:.75; transform:scale(.985); }
.primary { background:#214E42; color:#FFF; }
.hero .primary { background:#DBE8BD; color:#214E42; }
.ghost { background:#FFF; border:1rpx solid #DEE4D5; }
.danger { background:#FFF0EB; color:#A74C39; }
.compact { padding:13rpx 20rpx; font-size:24rpx; }
.label { display:block; color:#53675B; font-size:24rpx; font-weight:600; margin:22rpx 0 10rpx; }
input,.picker,textarea { background:#F7F9F3; border:1rpx solid #DFE6D7; border-radius:16rpx; padding:20rpx; width:100%; font-size:28rpx; color:#203D34; }
input { height:90rpx; }
textarea { min-height:150rpx; }
.hint { font-size:22rpx; color:#839078; margin-top:10rpx; }
.notice { background:#FFF5DF; border:1rpx solid #EFDFB5; border-radius:18rpx; padding:22rpx; color:#916C30; margin:20rpx 0; font-size:24rpx; }
.error { background:#FFF0EA; border:1rpx solid #EDCEC1; color:#A04B37; border-radius:18rpx; padding:24rpx; margin:20rpx 0; font-size:25rpx; word-break:break-all; }
.empty { padding:55rpx 25rpx; text-align:center; color:#84907F; }
.loading { color:#869574; padding:28rpx 0; text-align:center; }
.divider { border-top:1rpx solid #EEF0E8; margin:22rpx 0; }
.tiles { display:flex; gap:18rpx; flex-wrap:wrap; }
.tile { width:calc(50% - 9rpx); background:#FFF; padding:25rpx; border:1rpx solid #E2E7D9; border-radius:24rpx; }
.tile.green { background:#E8EED8; }
.tile-symbol { font-size:35rpx; color:#78975A; margin-bottom:10rpx; }
.stat { font-size:42rpx; font-weight:700; margin:8rpx 0; }
.link { color:#547943; font-size:24rpx; }
.search { margin:22rpx 0; }
.filters { display:flex; gap:12rpx; margin:18rpx 0 24rpx; flex-wrap:wrap; }
.chip { padding:11rpx 22rpx; border-radius:100rpx; background:#EDF0E7; color:#6E7F67; font-size:23rpx; }
.chip.selected { background:#214E42; color:#FFF; }
.record { margin-bottom:18rpx; }
.record-title { font-size:29rpx; font-weight:650; }
.record-sub { color:#8A9587; font-size:23rpx; margin:8rpx 0; }
.steps { display:flex; margin:24rpx 0; gap:9rpx; }
.step { flex:1; font-size:21rpx; text-align:center; color:#8F9B86; border-top:5rpx solid #E0E7D5; padding-top:12rpx; }
.step.active { color:#214E42; border-color:#729150; font-weight:650; }
.check { display:flex; align-items:flex-start; font-size:25rpx; gap:10rpx; margin:22rpx 0; }
.check checkbox { transform:scale(.8); transform-origin:left top; }
.footer { color:#96A08F; font-size:19rpx; letter-spacing:2rpx; margin-top:40rpx; text-align:center; }
.line-name { font-weight:650; font-size:28rpx; }
.line-grid { display:flex; gap:20rpx; }
.line-grid .grow { width:50%; }
.safe-bottom { padding-bottom:env(safe-area-inset-bottom); }
