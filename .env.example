APP_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=foxcore
DB_PASSWORD=replace-with-random-local-secret
DB_NAME=foxcore_dev
COOKIE_SECURE=false

# —— 云端部署（Vercel + TiDB Cloud）可选变量，本地部署不需要 ——
# DB_SSL=true                      # 云端数据库强制 TLS
# OWNER_PASSWORD=<至少32字符>       # 首次云端初始化必填；也可用 OWNER_PASSWORD_FILE，绝不打印密码
# ALLOW_PRODUCTION_MIGRATION=yes   # 允许生产环境执行初始化迁移（仅云端构建期需要）
