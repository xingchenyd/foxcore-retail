APP_ENV=production
NODE_ENV=production
WORKBUDDY=1
HOST=0.0.0.0
# Platform-injected PORT takes precedence over this fallback.
PORT=3000
PUBLIC_ORIGIN=https://REPLACE-WITH-ASSIGNED-DOMAIN.invalid
COOKIE_SECURE=true

# Existing MySQL-protocol database; remote connections require verified TLS.
DB_HOST=REPLACE-WITH-DATABASE-HOST
DB_PORT=4000
DB_USER=REPLACE-WITH-RESTRICTED-RUNTIME-USER
DB_PASSWORD=REPLACE-LOCALLY-NEVER-COMMIT
DB_NAME=foxcore
DB_SSL=true

# Only for the explicit setup:cloud command; remove from runtime after setup.
# ALLOW_PRODUCTION_MIGRATION=yes
# DB_MIGRATION_USER=REPLACE-WITH-SCHEMA-ADMIN
# DB_MIGRATION_PASSWORD=REPLACE-LOCALLY-NEVER-COMMIT
# OWNER_PASSWORD=REPLACE-WITH-32-OR-MORE-RANDOM-CHARACTERS
# DB_PASSWORD_FILE / DB_MIGRATION_PASSWORD_FILE / OWNER_PASSWORD_FILE are supported.

# If the platform assigns the origin only after first deployment:
# CLOUD_BOOTSTRAP=health-only
# Bootstrap exposes only liveness; /health/ready and all business paths return 503.

# Optional Mini Program build configuration (public identifiers, never secrets).
# FOXCORE_MINI_API_URL=https://YOUR-VERIFIED-API-DOMAIN
# FOXCORE_MINI_APPID=wx0123456789abcdef
