{
  "openapi": "3.1.0",
  "info": {
    "title": "Foxcore Staff Mini Program additions",
    "version": "2026-10-26"
  },
  "paths": {
    "/api/v1/auth/mini/login": {
      "post": {
        "operationId": "miniStaffLogin",
        "summary": "工作人员小程序登录（随机会话 bearer，无 Cookie）",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "成功；详细响应字段见 SRS 与实现",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "权限或 CSRF 拒绝"
          },
          "409": {
            "description": "状态、版本或约束冲突"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "username": {
                    "description": "字段语义/条件见 SRS 和服务端校验"
                  },
                  "password": {
                    "description": "字段语义/条件见 SRS 和服务端校验"
                  }
                }
              }
            }
          }
        },
        "description": "与网页登录共用员工口令、锁定与审计。返回 accessToken、csrf、user、expiresIn=43200、idleTimeout=1800；AppSecret 不需要；不使用微信 code2Session。",
        "security": []
      }
    },
    "/api/v1/sales/{id}/edit": {
      "post": {
        "operationId": "miniEditSale",
        "summary": "原生小程序 POST 编辑销售草稿",
        "tags": [
          "sales"
        ],
        "responses": {
          "200": {
            "description": "成功；详细响应字段见 SRS 与实现",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "权限或 CSRF 拒绝"
          },
          "409": {
            "description": "状态、版本或约束冲突"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "staffBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "description": "字段语义/条件见 SRS 和服务端校验"
                  },
                  "lines": {
                    "description": "字段语义/条件见 SRS 和服务端校验"
                  }
                }
              }
            }
          }
        },
        "description": "与原 PATCH 入口共用同一个 editSale 事务函数；版本、权限、CSRF、幂等规则一致。"
      }
    },
    "/api/v1/commissions/settlements/{id}": {
      "get": {
        "operationId": "getCommissionSettlement",
        "summary": "结算与来源明细（OWNER 或本人）",
        "security": [
          {
            "session": []
          },
          {
            "staffBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "settlement 与 lines；金额为整数分字符串，来源含销售正项与退货负项"
          },
          "401": {
            "description": "无效或过期会话"
          },
          "404": {
            "description": "不存在或不属于本人"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "foxcore_session"
      },
      "staffBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "随机43字符会话，服务端只存哈希；不可与Cookie同时发送。写请求继续带X-CSRF-Token。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "FixPage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "total",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
