@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #356553
skinparam LineColor #356553
skinparam packageStyle rectangle
skinparam classBackgroundColor #F4F7EF
skinparam classBorderColor #356553
skinparam usecaseBackgroundColor #F4F7EF
skinparam usecaseBorderColor #356553
skinparam stateBackgroundColor #F4F7EF
skinparam stateBorderColor #356553
skinparam noteBackgroundColor #FFF6DC
skinparam noteBorderColor #C7AB63
hide empty members
title 销售退换货与佣金 ERD
left to right direction
hide methods
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 95
entity "cash_handovers" as cash_handovers {
 {field} * id : bigint <<PK>>
 {field} * shift_id : bigint <<UK,FK>>
 {field} * difference_cents : bigint
 {field} * state : varchar(32)
 {field} * submitted_by : bigint <<FK>>
 {field} reviewed_by : bigint <<FK>>
 {field} * version : integer
}
entity "commission_claims" as commission_claims {
 {field} * entry_id : bigint <<PK,FK>>
 {field} * settlement_id : bigint <<FK>>
}
entity "commission_entries" as commission_entries {
 {field} * id : bigint <<PK>>
 {field} * salesperson_id : bigint <<FK>>
 {field} * source_kind : varchar(32)
 {field} * currency : character(3)
}
entity "commission_settlements" as commission_settlements {
 {field} * id : bigint <<PK>>
 {field} * salesperson_id : bigint <<FK>>
 {field} * state : varchar(32)
 {field} * total_cents : bigint
 {field} * created_by : bigint <<FK>>
 {field} * currency : character(3)
}
entity "commission_settlement_lines" as commission_settlement_lines {
 {field} * settlement_id : bigint <<PK,FK>>
 {field} * entry_id : bigint <<PK,FK>>
}
entity "exchanges" as exchanges {
 {field} * id : bigint <<PK>>
 {field} * original_sale_id : bigint <<FK>>
 {field} return_id : bigint <<UK,FK>>
 {field} new_sale_id : bigint <<UK,FK>>
 {field} * state : varchar(32)
 {field} * currency : character(3)
 {field} * difference_cents : bigint
 {field} * created_by : bigint <<FK>>
}
entity "returns" as returns {
 {field} * id : bigint <<PK>>
 {field} * sale_id : bigint <<FK>>
 {field} * state : varchar(32)
 {field} destination_location_id : bigint <<FK>>
 {field} * created_by : bigint <<FK>>
 {field} * total_cents : bigint
 {field} cash_shift_id : bigint <<FK>>
 {field} exchange_id : bigint <<FK>>
 {field} refund_method : varchar(32)
}
entity "return_lines" as return_lines {
 {field} * return_id : bigint <<PK,FK>>
 {field} * line_no : integer <<PK>>
 {field} * quantity : integer
}
entity "sales" as sales {
 {field} * id : bigint <<PK>>
 {field} sale_no : varchar(40) <<UK>>
 {field} * shift_id : bigint <<FK>>
 {field} * event_id : bigint <<FK>>
 {field} * state : varchar(32)
 {field} * created_by : bigint <<FK>>
 {field} posted_by : bigint <<FK>>
 {field} * total_cents : bigint
 {field} * version : integer
 {field} * currency : character(3)
 {field} * price_basis : varchar(32)
 {field} return_days : integer
 {field} exchange_id : bigint <<FK>>
}
entity "sale_lines" as sale_lines {
 {field} * sale_id : bigint <<PK,FK>>
 {field} * line_no : integer <<PK>>
 {field} * product_id : bigint <<FK>>
 {field} * quantity : integer
}
entity "shifts" as shifts {
 {field} * id : bigint <<PK>>
 {field} * salesperson_id : bigint <<FK>>
 {field} * booth_id : bigint <<FK>>
 {field} * status : varchar(32)
 {field} * version : integer
}
shifts ||--o| cash_handovers
commission_entries ||--o| commission_claims
commission_settlements ||--o{ commission_claims
commission_entries ||--o{ commission_settlement_lines
commission_settlements ||--o{ commission_settlement_lines
sales |o--o{ exchanges
returns |o--o| exchanges
shifts |o--o{ returns
exchanges |o--o{ returns
sales ||--o{ returns
returns ||--o{ return_lines
exchanges |o--o{ sales
shifts ||--o{ sales
sales ||--o{ sale_lines
@enduml
