@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #356553
skinparam LineColor #356553
skinparam packageStyle rectangle
skinparam classBackgroundColor #F4F7EF
skinparam classBorderColor #356553
skinparam usecaseBackgroundColor #F4F7EF
skinparam usecaseBorderColor #356553
skinparam stateBackgroundColor #F4F7EF
skinparam stateBorderColor #356553
skinparam noteBackgroundColor #FFF6DC
skinparam noteBorderColor #C7AB63
hide empty members
title 账号、云端草稿和审批 ERD
left to right direction
hide methods
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 95
entity "audit_events" as audit_events {
 {field} * id : bigint <<PK>>
 {field} actor_id : bigint <<FK>>
 {field} * created_at : timestamp(3)
}
entity "business_settings" as business_settings {
 {field} * id : smallint <<PK>>
 {field} * currency : character(3)
 {field} * price_basis : varchar(32)
 {field} * return_days : integer
 {field} * version : integer
}
entity "idempotency_keys" as idempotency_keys {
 {field} * actor_id : bigint <<PK,FK>>
 {field} * operation : varchar(80) <<PK>>
 {field} * command_key : character(36) <<PK>>
}
entity "salespeople" as salespeople {
 {field} * id : bigint <<PK>>
 {field} * version : integer
}
entity "sale_workspaces" as sale_workspaces {
 {field} * owner_id : bigint <<PK,FK>>
 {field} * workspace_key : varchar(80) <<PK>>
 {field} * revision : integer
}
entity "sale_workspace_revisions" as sale_workspace_revisions {
 {field} * owner_id : bigint <<PK,FK>>
 {field} * workspace_key : varchar(80) <<PK,FK>>
 {field} * revision : integer <<PK>>
}
entity "sessions" as sessions {
 {field} * id : bigint <<PK>>
 {field} * user_id : bigint <<FK>>
 {field} * token_hash : character(64) <<UK>>
}
entity "shifts" as shifts {
 {field} * id : bigint <<PK>>
 {field} * salesperson_id : bigint <<FK>>
 {field} * booth_id : bigint <<FK>>
 {field} * status : varchar(32)
 {field} * version : integer
}
entity "shift_extensions" as shift_extensions {
 {field} * id : bigint <<PK>>
 {field} * shift_id : bigint <<FK>>
 {field} * state : varchar(32)
 {field} * requested_by : bigint <<FK>>
 {field} reviewed_by : bigint <<FK>>
}
entity "users" as users {
 {field} * id : bigint <<PK>>
 {field} * username : varchar(80) <<UK>>
 {field} salesperson_id : bigint <<UK,FK>>
}
users |o--o{ audit_events
users ||--o{ idempotency_keys
users ||--o{ sale_workspaces
sale_workspaces ||--o{ sale_workspace_revisions
users ||--o{ sessions
salespeople ||--o{ shifts
users |o--o{ shift_extensions
shifts ||--o{ shift_extensions
salespeople |o--o| users
@enduml
