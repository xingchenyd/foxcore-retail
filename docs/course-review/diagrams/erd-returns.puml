@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam ArrowColor #526A68
skinparam classBorderColor #476C68
skinparam classBackgroundColor #F1F7F5
skinparam classAttributeIconSize 0
skinparam packageBorderColor #AABCB7
skinparam packageBackgroundColor #FAFCFB
skinparam sequenceParticipantBackgroundColor #E9F3EF
skinparam sequenceParticipantBorderColor #476C68
skinparam sequenceLifeLineBorderColor #B8C7C2
skinparam actorBorderColor #476C68
skinparam usecaseBackgroundColor #EFF6F3
skinparam usecaseBorderColor #476C68
skinparam stateBackgroundColor #EFF6F3
skinparam stateBorderColor #476C68
skinparam noteBackgroundColor #FFF6E6
skinparam noteBorderColor #D6AF6E
title 物理 ERD · 退货与原单
hide circle
left to right direction
entity "returns" as returns {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * sale_id : BIGINT UNSIGNED <<FK>>
  {field} * state : ENUM
  {field} * reason : VARCHAR(500)
  {field} refund_reference : VARCHAR(120)
  {field} destination_location_id : BIGINT UNSIGNED <<FK>>
  {field} * created_by : BIGINT UNSIGNED <<FK>>
  {field} authorized_at : DATETIME(3)
  {field} posted_at : DATETIME(3)
  {field} * net_cents : BIGINT UNSIGNED
  {field} * tax_cents : BIGINT UNSIGNED
  {field} * total_cents : BIGINT UNSIGNED
  {field} * created_at : DATETIME(3)
}
entity "return_lines" as return_lines {
  {field} * return_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * line_no : SMALLINT UNSIGNED <<PK>>
  {field} * sale_line_no : SMALLINT UNSIGNED
  {field} * quantity : INT UNSIGNED
  {field} * disposition : ENUM
  {field} * net_cents : BIGINT UNSIGNED
  {field} * tax_cents : BIGINT UNSIGNED
  {field} * commission_cents : BIGINT UNSIGNED
}
entity "sales" as sales {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} sale_no : VARCHAR(40) <<UK>>
  {field} * shift_id : BIGINT UNSIGNED <<FK>>
  {field} * event_id : BIGINT UNSIGNED <<FK>>
  {field} * state : ENUM
  {field} * created_at : DATETIME(3)
  {field} prepared_at : DATETIME(3)
  {field} posted_at : DATETIME(3)
  {field} * created_by : BIGINT UNSIGNED <<FK>>
  {field} posted_by : BIGINT UNSIGNED <<FK>>
  {field} payment_method : ENUM
  {field} payment_reference : VARCHAR(120)
  {field} cash_received_cents : BIGINT UNSIGNED
  {field} * net_cents : BIGINT UNSIGNED
  {field} * tax_cents : BIGINT UNSIGNED
  {field} * total_cents : BIGINT UNSIGNED
  {field} * version : INT UNSIGNED
}
entity "sale_lines" as sale_lines {
  {field} * sale_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * line_no : SMALLINT UNSIGNED <<PK>>
  {field} * product_id : BIGINT UNSIGNED <<FK>>
  {field} * quantity : INT UNSIGNED
  {field} * final_unit_price_cents : BIGINT UNSIGNED
  {field} * line_net_cents : BIGINT UNSIGNED
  {field} * line_tax_cents : BIGINT UNSIGNED
  {field} * line_commission_cents : BIGINT UNSIGNED
  {field} cost_snapshot_cents : BIGINT UNSIGNED
  {field} min_snapshot_cents : BIGINT UNSIGNED
  {field} tax_bps_snapshot : SMALLINT UNSIGNED
  {field} commission_bps_snapshot : SMALLINT UNSIGNED
  {field} name_snapshot : VARCHAR(160)
  {field} sku_snapshot : VARCHAR(64)
}
entity "stock_locations" as stock_locations {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * code : VARCHAR(80) <<UK>>
  {field} * name : VARCHAR(120)
  {field} * kind : ENUM
  {field} booth_id : BIGINT UNSIGNED <<FK,UK>>
  {field} * active : BOOLEAN
}
sales ||--o{ returns : "sale_id"
stock_locations |o--o{ returns : "destination_location_id"
returns ||--o{ return_lines : "return_id"
sales ||--o{ sale_lines : "sale_id"
sale_lines .. return_lines : "应用关联：returns.sale_id + sale_line_no\n无直接物理外键"
legend bottom
星号 (*) 表示 NOT NULL；PK 主键；FK 外键；UK 单列唯一。
实线只表示迁移中真实 FK；标注字段为子表列（含复合 FK）。
父端 1 / 0..1 由子 FK 可空性决定；子端 0..N / 0..1 由唯一性决定。
跨域外键及复合 UNIQUE/CHECK 全文见数据字典；图中 ENUM 值缩写。
endlegend
@enduml
