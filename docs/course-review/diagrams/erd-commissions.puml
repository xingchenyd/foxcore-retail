@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam ArrowColor #526A68
skinparam classBorderColor #476C68
skinparam classBackgroundColor #F1F7F5
skinparam classAttributeIconSize 0
skinparam packageBorderColor #AABCB7
skinparam packageBackgroundColor #FAFCFB
skinparam sequenceParticipantBackgroundColor #E9F3EF
skinparam sequenceParticipantBorderColor #476C68
skinparam sequenceLifeLineBorderColor #B8C7C2
skinparam actorBorderColor #476C68
skinparam usecaseBackgroundColor #EFF6F3
skinparam usecaseBorderColor #476C68
skinparam stateBackgroundColor #EFF6F3
skinparam stateBorderColor #476C68
skinparam noteBackgroundColor #FFF6E6
skinparam noteBorderColor #D6AF6E
title 物理 ERD · 佣金与结算
hide circle
left to right direction
entity "commission_entries" as commission_entries {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * salesperson_id : BIGINT UNSIGNED <<FK>>
  {field} * amount_cents : BIGINT
  {field} * source_kind : ENUM
  {field} * source_id : BIGINT UNSIGNED
  {field} * source_line_no : SMALLINT UNSIGNED
  {field} * created_at : DATETIME(3)
}
entity "commission_settlements" as commission_settlements {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * salesperson_id : BIGINT UNSIGNED <<FK>>
  {field} * state : ENUM
  {field} * cutoff_at : DATETIME(3)
  {field} * total_cents : BIGINT
  {field} payment_reference : VARCHAR(120)
  {field} * created_by : BIGINT UNSIGNED <<FK>>
  {field} * created_at : DATETIME(3)
  {field} paid_at : DATETIME(3)
}
entity "commission_settlement_lines" as commission_settlement_lines {
  {field} * settlement_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * entry_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * amount_cents : BIGINT
}
entity "commission_claims" as commission_claims {
  {field} * entry_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * settlement_id : BIGINT UNSIGNED <<FK>>
}
entity "salespeople" as salespeople {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * first_name : VARCHAR(80)
  {field} * last_name : VARCHAR(80)
  {field} street : VARCHAR(120)
  {field} city : VARCHAR(80)
  {field} province : VARCHAR(80)
  {field} postal_code : VARCHAR(16)
  {field} phone : VARCHAR(32)
  {field} description : VARCHAR(500)
  {field} * active : BOOLEAN
  {field} commission_bps : SMALLINT UNSIGNED
  {field} * version : INT UNSIGNED
}
salespeople ||--o{ commission_entries : "salesperson_id"
salespeople ||--o{ commission_settlements : "salesperson_id"
commission_settlements ||--o{ commission_settlement_lines : "settlement_id"
commission_entries ||--o{ commission_settlement_lines : "entry_id"
commission_entries ||--o| commission_claims : "entry_id"
commission_settlements ||--o{ commission_claims : "settlement_id"
legend bottom
星号 (*) 表示 NOT NULL；PK 主键；FK 外键；UK 单列唯一。
实线只表示迁移中真实 FK；标注字段为子表列（含复合 FK）。
父端 1 / 0..1 由子 FK 可空性决定；子端 0..N / 0..1 由唯一性决定。
跨域外键及复合 UNIQUE/CHECK 全文见数据字典；图中 ENUM 值缩写。
endlegend
@enduml
