@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam ArrowColor #526A68
skinparam classBorderColor #476C68
skinparam classBackgroundColor #F1F7F5
skinparam classAttributeIconSize 0
skinparam packageBorderColor #AABCB7
skinparam packageBackgroundColor #FAFCFB
skinparam sequenceParticipantBackgroundColor #E9F3EF
skinparam sequenceParticipantBorderColor #476C68
skinparam sequenceLifeLineBorderColor #B8C7C2
skinparam actorBorderColor #476C68
skinparam usecaseBackgroundColor #EFF6F3
skinparam usecaseBorderColor #476C68
skinparam stateBackgroundColor #EFF6F3
skinparam stateBorderColor #476C68
skinparam noteBackgroundColor #FFF6E6
skinparam noteBorderColor #D6AF6E
title 物理 ERD · 库存与流水
hide circle
left to right direction
entity "stock_locations" as stock_locations {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * code : VARCHAR(80) <<UK>>
  {field} * name : VARCHAR(120)
  {field} * kind : ENUM
  {field} booth_id : BIGINT UNSIGNED <<FK,UK>>
  {field} * active : BOOLEAN
}
entity "stock_balances" as stock_balances {
  {field} * location_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * product_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * on_hand : BIGINT UNSIGNED
  {field} * reserved : BIGINT UNSIGNED
  {field} * version : INT UNSIGNED
}
entity "stock_documents" as stock_documents {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * kind : ENUM
  {field} from_location_id : BIGINT UNSIGNED <<FK>>
  {field} to_location_id : BIGINT UNSIGNED <<FK>>
  {field} * reason : VARCHAR(500)
  {field} * created_by : BIGINT UNSIGNED <<FK>>
  {field} * created_at : DATETIME(3)
}
entity "stock_document_lines" as stock_document_lines {
  {field} * document_id : BIGINT UNSIGNED <<PK,FK>>
  {field} * line_no : SMALLINT UNSIGNED <<PK>>
  {field} * product_id : BIGINT UNSIGNED <<FK>>
  {field} * quantity : INT
}
entity "stock_ledger" as stock_ledger {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * location_id : BIGINT UNSIGNED <<FK>>
  {field} * product_id : BIGINT UNSIGNED <<FK>>
  {field} * delta : BIGINT
  {field} * source_kind : ENUM
  {field} * source_id : BIGINT UNSIGNED
  {field} * source_line_no : SMALLINT UNSIGNED
  {field} * created_at : DATETIME(3)
}
entity "products" as products {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * sku : VARCHAR(64) <<UK>>
  {field} * name : VARCHAR(160)
  {field} * wholesale_cost_cents : BIGINT UNSIGNED
  {field} * min_price_cents : BIGINT UNSIGNED
  {field} suggested_price_cents : BIGINT UNSIGNED
  {field} * active : BOOLEAN
  {field} * version : INT UNSIGNED
}
entity "booths" as booths {
  {field} * id : BIGINT UNSIGNED <<PK>>
  {field} * event_id : BIGINT UNSIGNED <<FK>>
  {field} * location : VARCHAR(80)
  {field} * active : BOOLEAN
}
booths |o--o| stock_locations : "booth_id"
stock_locations ||--o{ stock_balances : "location_id"
products ||--o{ stock_balances : "product_id"
stock_locations |o--o{ stock_documents : "from_location_id"
stock_locations |o--o{ stock_documents : "to_location_id"
stock_documents ||--o{ stock_document_lines : "document_id"
products ||--o{ stock_document_lines : "product_id"
stock_locations ||--o{ stock_ledger : "location_id"
products ||--o{ stock_ledger : "product_id"
legend bottom
星号 (*) 表示 NOT NULL；PK 主键；FK 外键；UK 单列唯一。
实线只表示迁移中真实 FK；标注字段为子表列（含复合 FK）。
父端 1 / 0..1 由子 FK 可空性决定；子端 0..N / 0..1 由唯一性决定。
跨域外键及复合 UNIQUE/CHECK 全文见数据字典；图中 ENUM 值缩写。
endlegend
@enduml
