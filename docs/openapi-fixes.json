                    ],
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "policyConfirmed": {
                    "type": "boolean"
                  }
                },
                "minProperties": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed or replayed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "version",
                    "taxBps",
                    "policyConfirmed"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "DRAFT"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967294
                    },
                    "taxBps": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "policyConfirmed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired session"
          },
          "403": {
            "description": "Role/CSRF restriction"
          },
          "404": {
            "description": "Missing resource"
          },
          "409": {
            "description": "State/version/idempotency conflict"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
