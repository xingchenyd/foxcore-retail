{
  "openapi": "3.1.0",
  "info": {
    "title": "Foxcore repair overlay",
    "version": "1.0.0-fixes"
  },
  "paths": {
    "/api/v1/shifts/{id}/cancel": {
      "post": {
        "summary": "Cancel an unstarted PLANNED shift",
        "description": "OWNER only. Session cookie and X-CSRF-Token required. Same idempotency key with same canonical request replays; different request conflicts. Explicit runtime validation, not auto-registered JSON Schema.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "reason"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967294
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed or replayed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "CANCELLED"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967294
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired session"
          },
          "403": {
            "description": "Role/CSRF restriction"
          },
          "404": {
            "description": "Missing resource"
          },
          "409": {
            "description": "State/version/idempotency conflict"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/events/{id}": {
      "patch": {
        "summary": "Complete DRAFT event tax/policy; at least one changed field required",
