              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967294
                  },
                  "taxBps": {
                    "type": [
                      "integer",
