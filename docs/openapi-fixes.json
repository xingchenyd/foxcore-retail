    "/api/v1/reports/sales": {
      "get": {
        "summary": "Paged original-event net sales",
        "description": "POSTED sales less POSTED returns; original event attribution. eventId intersects authenticated salesperson scope. Staff response excludes estimated_margin_cents. Stable net amount DESC, ID ASC. Count and page share one DB snapshot; separate requests do not share a snapshot.",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "event",
                "product",
                "salesperson"
              ],
              "default": "event"
            }
          },
          {
            "name": "eventId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged groups, not sales-line count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FixPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid group/event/paging"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/reports/sales.csv": {
      "get": {
        "summary": "OWNER full filtered CSV, not current page",
        "description": "Maximum 10000 groups; exceed limit returns 413 with no partial successful CSV. Same original-event facts. UTF-8 BOM and quoted cells; dangerous text prefixed with apostrophe; numeric negative values retained. limit/offset validated if supplied but not applied to export.",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "event",
                "product",
                "salesperson"
              ],
              "default": "event"
            }
          },
          {
            "name": "eventId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "foxcore-report.csv",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters/paging"
          },
          "403": {
            "description": "OWNER required"
          },
          "413": {
            "description": "Over 10000 groups; narrow event scope"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
